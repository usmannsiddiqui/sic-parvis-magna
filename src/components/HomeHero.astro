---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  meta: string;
  href: string;
  image?: ImageMetadata;
}
const { title, meta, href, image } = Astro.props;
---

<section class="hero-wrap">
  <a href={href} class="hero" data-hero>
    {
      image && (
        <Image
          class="hero-img"
          src={image}
          alt=""
          widths={[760, 1200, 1800]}
          sizes="(max-width: 1264px) 100vw, 1136px"
        />
      )
    }
    <div class="hero-scrim"></div>
    <div class="hero-body">
      <div class="hero-kicker">Featured</div>
      <h1 class="hero-title">{title}</h1>
      <div class="hero-meta">{meta}</div>
    </div>
  </a>
</section>

<style>
  .hero-wrap {
    max-width: 1200px;
    margin: 40px auto 0;
    padding: 0 32px;
  }
  .hero {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 7;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid var(--border);
    transform-origin: top center;
    will-change: transform;
    background:
      repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.05) 0 1px, transparent 1px 18px),
      repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.05) 0 1px, transparent 1px 18px),
      linear-gradient(150deg, var(--ph1) 0%, var(--ph2) 60%, var(--ph1) 100%);
  }
  /* Cover-crops the wide source into the 16:7 slot. Centred: a top bias clipped
     the foreground subject, and the 16:9 source only loses ~22% of its height
     here, so both sky and ground survive a centre crop. */
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 600ms ease;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(9, 11, 15, 0.9) 0%,
      rgba(9, 11, 15, 0.45) 42%,
      transparent 72%
    );
  }
  .hero-body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0 24px 40px;
    text-align: center;
  }
  .hero-kicker {
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--fire);
    margin-bottom: 14px;
  }
  .hero-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(30px, 4.4vw, 58px);
    line-height: 1.05;
    color: #f4efe4;
    margin: 0 auto;
    max-width: 760px;
    text-wrap: balance;
  }
  .hero-meta {
    font-family: var(--font-sans);
    font-size: 13.5px;
    color: rgba(244, 239, 228, 0.72);
    margin-top: 16px;
  }

  @media (min-width: 640px) {
    .hero {
      border-radius: 16px;
    }
  }

  /* Hover: same image zoom + elevation as ArticleCard (pointer devices only).
     The scale goes on the image, never on .hero — GSAP owns .hero's transform. */
  @media (hover: hover) {
    .hero:hover {
      box-shadow: var(--shadow-card);
    }
    .hero:hover .hero-img {
      transform: scale(1.05);
    }
  }

  /* Reduced motion: fully static */
  @media (prefers-reduced-motion: reduce) {
    .hero-img {
      transition: none;
    }
    .hero:hover .hero-img {
      transform: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const el = document.querySelector<HTMLElement>('[data-hero]');

  // Progressive enhancement: only enhance on wide viewports, motion allowed, and element present.
  if (el && !prefersReduced && window.innerWidth >= 760) {
    gsap.registerPlugin(ScrollTrigger);
    gsap.to(el, {
      scale: 0.89,
      ease: 'none',
      scrollTrigger: {
        trigger: el,
        start: 'top top',
        end: '+=420',
        scrub: true,
      },
    });
  }
</script>
