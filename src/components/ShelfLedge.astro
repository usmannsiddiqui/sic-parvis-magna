---
export interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['ledge', className]} aria-hidden="true"></div>

<style>
  .ledge {
    height: 13px;
    background: var(--ledge);
    border-radius: 0 0 3px 3px;
    box-shadow:
      inset 0 2px 0 color-mix(in srgb, #fff 26%, transparent),
      0 12px 18px -12px var(--ledge-edge);
    border-bottom: 2px solid color-mix(in srgb, var(--text) 20%, transparent);
  }
</style>
